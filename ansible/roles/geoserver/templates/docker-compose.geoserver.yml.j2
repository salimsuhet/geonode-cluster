# docker-compose.yml — GeoServer {{ geoserver_role | upper }}
# Nó: {{ inventory_hostname }}
# Gerenciado pelo Ansible — não edite manualmente

services:
  geoserver:
    image: {{ geoserver_image }}
    container_name: geoserver
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "{{ geoserver_port }}:8080"
    # O entrypoint wrapper copia os JARs de /opt/additional_plugins para WEB-INF/lib
    # antes de iniciar o Tomcat. O classloader do Tomcat carrega JARs apenas do
    # diretório raiz de WEB-INF/lib — nunca de subdirectórios — por isso a montagem
    # anterior em .../WEB-INF/lib/extra era ineficaz e o menu JMS-Cluster não aparecia.
    entrypoint: ["/bin/bash", "/usr/local/bin/copy-plugins.sh"]
{% if geoserver_is_master | bool %}
    # Aguarda o ActiveMQ estar healthy antes de iniciar o GeoServer.
    # Sem isso, o GeoServer tenta conectar ao broker antes dele estar pronto,
    # a primeira tentativa JMS falha e o cluster não se forma após o deploy.
    depends_on:
      activemq:
        condition: service_healthy
{% endif %}

    volumes:
      - {{ geoserver_data_dir }}:/opt/geoserver/data_dir
      - {{ geoserver_data_dir }}/plugins:/opt/additional_plugins:ro
      # cluster.properties local (fora do NFS) sobrepõe o arquivo compartilhado.
      # O data_dir dos workers é montado via NFS do master; sem este mount,
      # o Ansible do worker sobrescreve o cluster.properties do master.
      - /opt/geoserver/cluster.properties:/opt/geoserver/data_dir/cluster.properties
      # lib nativa GDAL pré-compilada — copiada pelo copy-plugins.sh para
      # native-jni-lib (java.library.path) antes de o Tomcat iniciar.
      - /opt/geoserver/gdal-native:/opt/gdal-native:ro
      - /opt/geoserver/copy-plugins.sh:/usr/local/bin/copy-plugins.sh:ro
      - {{ geoserver_data_dir }}/logs:/opt/geoserver/logs
      # set_geoserver_auth.sh corrigido: remove a linha `echo " " >> file`
      # do script original da imagem, que adicionava trailing whitespace nos
      # arquivos XML de segurança e causava java.io.EOFException no XStream
      # durante a autenticação OAuth2.
      - /opt/geoserver/set_geoserver_auth.sh:/usr/local/tomcat/tmp/set_geoserver_auth.sh:ro
    environment:
      # Estes sobrescrevem o .env intencionalmente para garantir os valores corretos
      GEOSERVER_DATA_DIR: /opt/geoserver/data_dir
      GEOWEBCACHE_CACHE_DIR: /opt/geoserver/data_dir/gwc
      # JAVA_OPTS em uma linha só — docker-compose não tem o problema do .env com multilinha
      JAVA_OPTS: "{{ geoserver_java_opts }}"
      # Broker URL via system property.
      # Master: usa nome de serviço Docker (evita hairpin NAT no OpenStack —
      # o container não consegue alcançar o próprio IP externo pela rede privada).
      # Workers: usam IP privado do master + porta externa 61666.
      CATALINA_OPTS: >-
        -DGEOSERVER_CSRF_DISABLED=true
{% if geoserver_is_master | bool %}
        -Dorg.geoserver.cluster.jms.broker=tcp://activemq:61616
{% else %}
        -Dorg.geoserver.cluster.jms.broker={{ geoserver_cluster_broker_url }}
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/geoserver/web/"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
    networks:
      - geoserver_cluster

{% if geoserver_is_master | bool %}
  # ActiveMQ broker — apenas no master (write)
  activemq:
    image: apache/activemq-classic:5.18.4
    container_name: activemq
    restart: unless-stopped
    ports:
      - "61616:61616"   # OpenWire (JMS interno)
      - "61666:61666"   # OpenWire (acesso externo dos workers)
      - "8161:8161"     # Console admin
    environment:
      ACTIVEMQ_ADMIN_LOGIN: admin
      ACTIVEMQ_ADMIN_PASSWORD: "{{ geoserver_admin_password }}"
    volumes:
      - activemq_data:/opt/activemq/data
    networks:
      - geoserver_cluster
    healthcheck:
      # /api/health não existe no ActiveMQ 5.18. Verifica a porta OpenWire
      # (61616) via builtin TCP do bash — sem dependência de curl nem auth.
      test: ["CMD-SHELL", "bash -c '</dev/tcp/localhost/61616' 2>/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

volumes:
  activemq_data:

{% endif %}

networks:
  geoserver_cluster:
    external: true

<geoNodeOauth2Authentication>
  <id>-313f4319:15766e137c9:-8000</id>
  <name>geonode-oauth2</name>
  <className>org.geoserver.security.oauth2.GeoNodeOAuthAuthenticationFilter</className>
  <roleSource class="org.geoserver.security.config.PreAuthenticatedUserNameFilterConfig$PreAuthenticatedUserNameRoleSource">RoleService</roleSource>
  <userGroupServiceName>default</userGroupServiceName>
  <roleServiceName>geonode REST role service</roleServiceName>

  <!--
    ATENÇÃO: <cliendId> (sem 't') é intencional.
    O XStream deserializa pelo nome exato do campo Java na classe
    GeoNodeOAuthAuthenticationFilterConfig. Corrigir para <clientId>
    faz o plugin carregar client_id=null silenciosamente.
  -->
  <cliendId>{{ oauth2_client_id }}</cliendId>
  <clientSecret>{{ oauth2_client_secret }}</clientSecret>

  <!--
    accessTokenUri — chamada server-side (GeoServer → GeoNode).
    Usa o IP interno do GeoNode para evitar hairpin NAT no OpenStack:
    instâncias não conseguem alcançar o próprio Floating IP a partir
    da rede privada.
  -->
  <accessTokenUri>http://{{ ip_geonode }}/o/token/</accessTokenUri>

  <!--
    userAuthorizationUri — redirect do browser do usuário.
    Usa o hostname público pois é o browser que acessa, não o GeoServer.
  -->
  <userAuthorizationUri>http://{{ geonode_public_hostname }}/o/authorize/</userAuthorizationUri>

  <!-- GeoServer Public URL — redirect do browser após autorização -->
  <redirectUri>http://{{ geonode_public_hostname }}/geoserver/index.html</redirectUri>

  <!--
    checkTokenEndpointUrl — chamada server-side (GeoServer → GeoNode).
    Usa /api/o/v4/tokeninfo/ — endpoint customizado do GeoNode que retorna
    os campos no formato que o GeoNodeOAuthAuthenticationFilter espera,
    incluindo user_name (com underscore) usado pelo Spring Security OAuth2
    para extrair o principal. O /o/introspect/ (RFC 7662) retorna username
    sem underscore, causando principal=null e falha silenciosa no login.
    Usa o IP interno para evitar hairpin NAT.
  -->
  <checkTokenEndpointUrl>http://{{ ip_geonode }}/api/o/v4/tokeninfo/</checkTokenEndpointUrl>

  <!-- GeoNode logoutUri — redirect do browser -->
  <logoutUri>http://{{ geonode_public_hostname }}/account/logout/</logoutUri>

  <scopes>write</scopes>
  <enableRedirectAuthenticationEntryPoint>false</enableRedirectAuthenticationEntryPoint>
  <forceAccessTokenUriHttps>false</forceAccessTokenUriHttps>
  <forceUserAuthorizationUriHttps>false</forceUserAuthorizationUriHttps>

  <!--
    loginEndpoint e logoutEndpoint usam o path sem prefixo /web/.
    O Wicket gera o form action como URL relativa à página (/geoserver/web/),
    resultando em /geoserver/web/j_spring_oauth2_geonode_login.
    O HAProxy reescreve esse path para /geoserver/j_spring_oauth2_geonode_login
    antes de encaminhar ao GeoServer, que é o path que o Spring Security escuta.
  -->
  <loginEndpoint>/j_spring_oauth2_geonode_login</loginEndpoint>
  <logoutEndpoint>/j_spring_oauth2_geonode_logout</logoutEndpoint>
</geoNodeOauth2Authentication>
